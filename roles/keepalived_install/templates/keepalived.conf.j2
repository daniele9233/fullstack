{% set balancers = groups['nginx_servers'] %}
{% set idx = balancers.index(inventory_hostname) %}
{% set is_master = (idx == 0) %}
{% set priority = keepalived_priority_master - (idx * keepalived_priority_step) %}
# {{ ansible_managed }} - roles/keepalived_install
# {{ inventory_hostname }}: {{ 'MASTER' if is_master else 'BACKUP' }} (priorita' {{ priority }})

global_defs {
    script_user root
    enable_script_security
}

# --- VIP 1: {{ vip_rancher_ip }} - console Rancher e servizi, servito da nginx ---

# Health check vero: se nginx cade sul nodo che tiene il VIP, la priorita'
# scende di {{ keepalived_nginx_check_weight }} e il VIP passa all'altro nodo, dove nginx e' gia'
# in esecuzione. fall/rise a 2 per non spostare il VIP a ogni singolo campione.
vrrp_script chk_nginx_service {
    script "{{ keepalived_config_dir }}/nginx-ha-check"
    interval {{ keepalived_nginx_check_interval }}
    weight {{ keepalived_nginx_check_weight }}
    fall 2
    rise 2
}

vrrp_instance {{ keepalived_rancher_instance }} {
    state {{ 'MASTER' if is_master else 'BACKUP' }}
    priority {{ priority }}
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_vrid_rancher }}
    advert_int {{ keepalived_advert_int }}
    accept
    garp_master_refresh {{ keepalived_garp_master_refresh }}
    garp_master_refresh_repeat {{ keepalived_garp_master_refresh_repeat }}
    unicast_src_ip {{ hostvars[inventory_hostname].ansible_host }}
    unicast_peer {
{% for peer in balancers if peer != inventory_hostname %}
        {{ hostvars[peer].ansible_host }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ vip_rancher_ip }}/{{ vip_rancher_prefix }}
    }
    track_script {
        chk_nginx_service
    }
}

# --- VIP 2: {{ vip_patroni_ip }} - Patroni/PgBouncer, servito da haproxy ---

vrrp_script chk_haproxy {
    script "/usr/bin/pkill -0 haproxy"
    interval 5
    weight -4
    fall 2
    rise 1
}

vrrp_script chk_lb {
    script "/usr/bin/pkill -0 keepalived"
    interval 1
    weight 6
    fall 2
    rise 1
}

vrrp_instance {{ keepalived_patroni_instance }} {
    state {{ 'MASTER' if is_master else 'BACKUP' }}
    priority {{ priority }}
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_vrid_patroni }}
    virtual_ipaddress {
        {{ vip_patroni_ip }}
    }
    {{ '#' }} Niente track_interface su {{ keepalived_interface }}: e' l'interfaccia dell'istanza,
    {{ '#' }} che keepalived traccia gia' da sola. Dichiararla esplicitamente non
    {{ '#' }} aggiunge nulla e fa uscire "keepalived --config-test" con codice 5,
    {{ '#' }} bloccando la validazione del template.
    track_script {
        chk_haproxy
        chk_lb
    }
}

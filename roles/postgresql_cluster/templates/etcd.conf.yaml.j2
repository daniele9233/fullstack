{% set nodes = groups[postgres_cluster_group] %}
{{ '#' }} {{ ansible_managed }} - roles/postgresql_cluster
name: '{{ inventory_hostname }}'
initial-cluster-token: etcd-cluster
{{ '#' }} "new" vale per la prima formazione del cluster. Per aggiungere un nodo a
{{ '#' }} un cluster gia' esistente servirebbe "existing": qui resta "new" perche'
{{ '#' }} il ruolo azzera comunque la directory dati a ogni esecuzione.
initial-cluster-state: new
initial-cluster: {% for host in nodes %}{{ host }}=http://{{ hostvars[host].ansible_host }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}

data-dir: {{ etcd_data_dir }}
initial-advertise-peer-urls: http://{{ hostvars[inventory_hostname].ansible_host }}:{{ etcd_peer_port }}
listen-peer-urls: http://{{ hostvars[inventory_hostname].ansible_host }}:{{ etcd_peer_port }}
advertise-client-urls: http://{{ hostvars[inventory_hostname].ansible_host }}:{{ etcd_client_port }}
listen-client-urls: http://{{ hostvars[inventory_hostname].ansible_host }}:{{ etcd_client_port }},http://localhost:{{ etcd_client_port }}
{{ '#' }} Nessun enable-v2: l'API v2 e' deprecata in etcd 3.5 e RIMOSSA in 3.6, dove
{{ '#' }} quell'opzione impedisce l'avvio. Patroni parla con il DCS in v3, vedi la
{{ '#' }} sezione etcd3 di patroni.yml.

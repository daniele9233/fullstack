{{ '#' }} {{ ansible_managed }} - roles/nginx_install
{% if nginx_load_stream_module %}
{{ '#' }} Serve solo se si aggiunge un blocco stream{}: la configurazione generata
{{ '#' }} qui usa esclusivamente http{}. Su pacchetti senza questo modulo (per
{{ '#' }} esempio nginx-light) caricarlo fa fallire l'avvio.
load_module {{ nginx_stream_module_path }};
{% endif %}
user {{ nginx_user }};
worker_processes {{ nginx_worker_processes }};
worker_rlimit_nofile {{ nginx_worker_rlimit_nofile }};
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections }};
}

http {
    server_names_hash_bucket_size {{ nginx_server_names_hash_bucket_size }};
    server_names_hash_max_size {{ nginx_server_names_hash_max_size }};
    client_max_body_size {{ nginx_client_max_body_size }};

    # Upstream generati dai gruppi [masters] e [ingress] dell'inventario:
    # aggiungere o togliere un nodo non richiede di toccare questo template.
    upstream rancher_servers_https {
{% for host in groups['masters'] %}
        server {{ hostvars[host].ansible_host }}:{{ rancher_https_port }} max_fails={{ nginx_upstream_max_fails }} fail_timeout={{ nginx_upstream_fail_timeout }};
{% endfor %}
    }

    upstream rancher_ingress_https {
{% for host in groups['ingress'] %}
        server {{ hostvars[host].ansible_host }}:{{ ingress_https_port }} max_fails={{ nginx_upstream_max_fails }} fail_timeout={{ nginx_upstream_fail_timeout }};
{% endfor %}
    }

    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # I server block HTTPS stanno in file separati. Gli include restano dentro
    # http{}: nel contesto main il primo server{} farebbe fallire nginx -t con
    # "directive is not allowed here".
    include /etc/nginx/conf.d/*.conf;
    include {{ nginx_conf_http_dir }}/*.conf;
}

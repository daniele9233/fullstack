{{ '#' }} {{ ansible_managed }} - roles/nginx_install
{% set rancher_backend_hosts = nginx_rancher_backend_hosts | default(groups.get('masters', [])) %}
{% set ingress_backend_hosts = nginx_ingress_backend_hosts | default(groups.get('ingress', [])) %}
{% if nginx_load_stream_module %}
load_module {{ nginx_stream_module_path }};
{% endif %}
user {{ nginx_user }};
worker_processes {{ nginx_worker_processes }};
worker_rlimit_nofile {{ nginx_worker_rlimit_nofile }};
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
#include /etc/nginx/modules-enabled/*.conf;
include /etc/nginx/conf.d/*.conf;
events {
        worker_connections {{ nginx_worker_connections }};
        # multi_accept on;
}
http {
    client_max_body_size {{ nginx_client_max_body_size }};

    {{ '#' }} Upstream generati dal gruppo [masters] dell'inventario.
    upstream rancher_servers_https {
        #least_conn;

{% for host in rancher_backend_hosts %}
        server {{ hostvars[host].ansible_host }}:{{ rancher_https_port }} max_fails={{ nginx_upstream_max_fails }} fail_timeout={{ nginx_upstream_fail_timeout }};
{% endfor %}
    }

{% if ingress_backend_hosts | length > 0 %}
    {{ '#' }} Upstream generati dal gruppo [ingress] dell'inventario.
    upstream rancher_ingress_https {
        #least_conn;

{% for host in ingress_backend_hosts %}
        server {{ hostvars[host].ansible_host }}:{{ ingress_https_port }} max_fails={{ nginx_upstream_max_fails }} fail_timeout={{ nginx_upstream_fail_timeout }};
{% endfor %}
    }
{% endif %}

    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$request_uri;
   }

   include {{ nginx_conf_http_dir }}/*.conf;
}

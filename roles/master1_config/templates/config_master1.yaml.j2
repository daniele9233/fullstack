{{ '#' }} {{ ansible_managed }} - roles/master1_config/templates/config_master1.yaml.j2
{% set first_master = groups['masters'][0] %}
{% if rke2_effective_token is defined and rke2_effective_token %}
token: {{ rke2_effective_token }}
{% else %}
{{ '#' }} Nessun token: questo nodo bootstrappa il cluster e RKE2 ne genera uno
{{ '#' }} in /var/lib/rancher/rke2/server/node-token, da cui lo leggono gli altri.
{% endif %}
{% if inventory_hostname != first_master %}
{{ '#' }} Nodo aggiuntivo: si registra sul supervisor del primo master.
{{ '#' }} La porta e' {{ rke2_supervisor_port }} (supervisor), non 6443 (API server).
server: https://{{ hostvars[first_master].ansible_host }}:{{ rke2_supervisor_port }}
{% endif %}
tls-san:
  - {{ rancher_domain }}
{% for host in groups['masters'] %}
  - {{ hostvars[host].ansible_host }}
{% endfor %}
{% for san in rke2_extra_tls_san %}
  - {{ san }}
{% endfor %}
{% if rke2_cni | length > 0 %}
cni:
{% for plugin in rke2_cni %}
  - {{ plugin }}
{% endfor %}
{% endif %}
{% if rke2_disable | length > 0 %}
disable:
{% for component in rke2_disable %}
  - {{ component }}
{% endfor %}
{% endif %}
{% if rke2_write_kubeconfig_mode %}
write-kubeconfig-mode: "{{ rke2_write_kubeconfig_mode }}"
{% endif %}
{% if rke2_resolv_conf_presente | default(false) %}

{{ '#' }} Il resolv.conf VERO, non lo stub 127.0.0.53 di systemd-resolved a cui
{{ '#' }} punta /etc/resolv.conf su Ubuntu. RKE2 vede il loopback e se ne
{{ '#' }} genera uno con 8.8.8.8 dentro: su rete aziendale chiusa non risponde,
{{ '#' }} e CoreDNS non risolve piu' nessun nome esterno. Il primo a caderci e'
{{ '#' }} il job che scarica il chart di Traefik da traefik.github.io.
resolv-conf: {{ rke2_resolv_conf }}
{% endif %}

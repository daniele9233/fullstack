{{ '#' }} {{ ansible_managed }} - roles/traefik_install
{{ '#' }} Installato dal helm-controller integrato in RKE2: questo file sta in
{{ '#' }} {{ traefik_manifest_dir }}, che rke2-server applica da solo.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: traefik
  namespace: kube-system
spec:
  chart: {{ traefik_chart }}
  repo: {{ traefik_repo }}
{% if traefik_chart_version | length > 0 %}
  version: "{{ traefik_chart_version }}"
{% endif %}
  targetNamespace: {{ traefik_namespace }}
  createNamespace: true
  valuesContent: |-
    deployment:
      kind: {{ traefik_kind }}

    {{ '#' }} Nessun Service: si entra dalle hostPort dei nodi, come faceva
    {{ '#' }} rke2-ingress-nginx. Un Service LoadBalancer resterebbe Pending,
    {{ '#' }} perche' nel cluster non c'e' nessun provider che lo soddisfi.
    service:
      enabled: false

    ports:
      web:
        hostPort: {{ traefik_host_http_port }}
      websecure:
        hostPort: {{ traefik_host_https_port }}

    ingressClass:
      enabled: true
      isDefaultClass: {{ traefik_default_ingress_class | bool | lower }}
{% if traefik_node_selector %}

    nodeSelector:
{% for key, value in traefik_node_selector.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if traefik_tolerations %}

    tolerations:
{% for toleration in traefik_tolerations %}
      - key: "{{ toleration.key }}"
{% if toleration.operator is defined %}
        operator: "{{ toleration.operator }}"
{% endif %}
{% if toleration.value is defined %}
        value: "{{ toleration.value }}"
{% endif %}
        effect: "{{ toleration.effect }}"
{% endfor %}
{% endif %}

{#
  Scheda di un singolo nodo.

  Il template non decide niente: impagina pf_righe e pf_blocchi cosi' come i
  ruoli preflight_* li hanno riempiti. Aggiungere un controllo vuol dire
  aggiungere una riga la', non toccare questo file.
#}
{% set L = pf_larghezza | int %}
{% set CV = pf_col_voce | int %}
{% set CD = pf_col_valore | int %}
{% set CE = pf_col_esito | int %}
{% set righe = pf_righe | default([]) %}
{% set titolo = pf_titolo_scheda | default(inventory_hostname ~ '  -  ' ~ (ansible_host | default('indirizzo non dichiarato')) ~ '  -  gruppi: ' ~ (group_names | reject('equalto', 'all') | join(', '))) %}
{{ '=' * L }}
  {{ titolo }}
{{ '=' * L }}
{% for sezione in pf_sezioni %}
{% set del_gruppo = righe | selectattr('sezione', 'equalto', sezione) | list %}
{% if del_gruppo | length > 0 %}

  {{ sezione }}
  {{ '-' * (L - 2) }}
{% for r in del_gruppo %}
{% set testo = r.valore | string | regex_replace('\s+', ' ') | trim %}
{% for pezzo in (testo | wordwrap(CD, wrapstring='\n')).split('\n') %}
  {{ ((r.voce ~ ' ')[:CV]).ljust(CV, '.') if loop.first else ' ' * CV }} {{ pezzo.ljust(CD) }} {{ ('[ ' ~ r.esito ~ ' ]').rjust(CE) if loop.first else '' }}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
{% set da_sistemare = righe | rejectattr('esito', 'in', ['OK', 'INFO']) | list %}
{% if da_sistemare | length > 0 %}

  DA SISTEMARE
  {{ '-' * (L - 2) }}
{% for r in da_sistemare %}
{% set nota = r.nota | string | regex_replace('\s+', ' ') | trim %}
  [{{ r.esito }}] {{ r.voce }} - {{ r.valore | string | regex_replace('\s+', ' ') | trim }}
{% for pezzo in (nota | wordwrap(L - 8, wrapstring='\n')).split('\n') %}
      {{ pezzo }}
{% endfor %}
{% endfor %}
{% endif %}
{% for b in (pf_blocchi | default([])) %}

  {{ b.titolo }}
  {{ '-' * (L - 2) }}
{% for riga in b.righe %}
    {{ riga }}
{% endfor %}
{% endfor %}
